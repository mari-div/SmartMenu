# Copia este archivo como ".env" y ajusta tus datos (el .env NO se sube a Git).

# PostgreSQL (crea antes la base:  createdb -U postgres smartmenu)
DATABASE_URL=postgresql+psycopg2://postgres:TU_PASSWORD@localhost:5432/smartmenu

# Para probar rapido sin PostgreSQL puedes usar SQLite:
# DATABASE_URL=sqlite:///smartmenu_dev.db

SECRET_KEY=cambia-esto
ESTACIONES_COCINA=3
